# Get a key from Google AI Studio. Server-side only; never put it in src/.
GEMINI_API_KEY=
# Model used by the Sarthi AI server.
GEMINI_MODEL=gemini-2.0-flash
# Port for the local Sarthi server.
PORT=8787

# Optional: free YouTube Data API v3 key (Google Cloud Console). Lets Swyam pick the most-watched lectures per chapter.
YOUTUBE_API_KEY=
